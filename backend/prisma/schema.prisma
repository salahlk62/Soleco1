// datasource and client configuration
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUMS
// ==========================================

enum UserRole {
  ADMIN
  MERCHANT
  STAFF
}

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum PageType {
  LANDING
  CHECKOUT
  THANK_YOU
  UPSELL
  LANDING_AND_CHECKOUT
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
  RETURNED
}

enum ShippingProviderName {
  YALIDINE
  ZR_EXPRESS
  ECOTRACK
  CUSTOM
}

// ==========================================
// MODELS
// ==========================================

/// المستخدمون والتجار
model User {
  id           String           @id @default(uuid()) @db.Uuid
  fullName     String           @map("full_name") @db.VarChar(100)
  email        String           @unique @db.VarChar(150)
  phoneNumber  String           @unique @map("phone_number") @db.VarChar(20)
  passwordHash String           @map("password_hash") @db.VarChar(255)
  role         UserRole         @default(MERCHANT)
  plan         SubscriptionPlan @default(FREE)
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  stores Store[]

  @@map("users")
}

/// المتاجر التابعة للتجار
model Store {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  name       String   @db.VarChar(100)
  slug       String   @unique @db.VarChar(100)
  currency   String   @default("DZD") @db.VarChar(10)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  merchant             User                  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products             Product[]
  funnels              Funnel[]
  orders               Order[]
  shippingIntegrations ShippingIntegration[]

  @@index([merchantId])
  @@map("stores")
}

/// المنتجات
model Product {
  id            String   @id @default(uuid()) @db.Uuid
  storeId       String   @map("store_id") @db.Uuid
  title         String   @db.VarChar(200)
  sku           String?  @unique @db.VarChar(50)
  description   String?  @db.Text
  basePrice     Decimal  @map("base_price") @db.Decimal(12, 2)
  stockQuantity Int      @default(0) @map("stock_quantity")
  images        Json?    @db.JsonB
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([storeId])
  @@map("products")
}

/// مسارات البيع (Funnels)
model Funnel {
  id        String   @id @default(uuid()) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  title     String   @db.VarChar(150)
  slug      String   @unique @db.VarChar(150)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  store  Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  pages  FunnelPage[]
  orders Order[]

  @@index([slug])
  @@index([storeId])
  @@map("funnels")
}

/// صفحات مسار البيع (Landing Pages / Checkout Pages)
model FunnelPage {
  id               String   @id @default(uuid()) @db.Uuid
  funnelId         String   @map("funnel_id") @db.Uuid
  pageType         PageType @default(LANDING) @map("page_type")
  stepOrder        Int      @map("step_order")
  contentJson      Json     @map("content_json") @db.JsonB
  viewsCount       Int      @default(0) @map("views_count")
  conversionsCount Int      @default(0) @map("conversions_count")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  funnel Funnel @relation(fields: [funnelId], references: [id], onDelete: Cascade)

  @@index([funnelId, stepOrder])
  @@map("funnel_pages")
}

/// الطلبات (Orders & Single-step Checkout)
model Order {
  id              String      @id @default(uuid()) @db.Uuid
  storeId         String      @map("store_id") @db.Uuid
  funnelId        String?     @map("funnel_id") @db.Uuid
  idempotencyKey  String?     @unique @map("idempotency_key") @db.VarChar(100)
  customerName    String      @map("customer_name") @db.VarChar(100)
  customerPhone   String      @map("customer_phone") @db.VarChar(20)
  wilaya          String      @db.VarChar(50)
  commune         String      @db.VarChar(50)
  address         String?     @db.Text
  subtotal        Decimal     @db.Decimal(12, 2)
  shippingCost    Decimal     @default(0.00) @map("shipping_cost") @db.Decimal(12, 2)
  totalAmount     Decimal     @map("total_amount") @db.Decimal(12, 2)
  status          OrderStatus @default(PENDING)
  trackingNumber  String?     @map("tracking_number") @db.VarChar(50)
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz()

  // Relations
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  funnel     Funnel?     @relation(fields: [funnelId], references: [id], onDelete: SetNull)
  orderItems OrderItem[]

  @@index([storeId, status])
  @@index([customerPhone])
  @@map("orders")
}

/// تفاصيل عناصر الطلب
model OrderItem {
  id        String  @id @default(uuid()) @db.Uuid
  orderId   String  @map("order_id") @db.Uuid
  productId String? @map("product_id") @db.Uuid
  quantity  Int
  unitPrice Decimal @map("unit_price") @db.Decimal(12, 2)

  // Relations
  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

/// تكاملات شركات الشحن (Yalidine, ZR, etc.)
model ShippingIntegration {
  id           String               @id @default(uuid()) @db.Uuid
  storeId      String               @map("store_id") @db.Uuid
  providerName ShippingProviderName @map("provider_name")
  apiKeyEnc    String               @map("api_key_enc") @db.Text
  apiSecretEnc String?              @map("api_secret_enc") @db.Text
  isActive     Boolean              @default(true) @map("is_active")
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz()

  // Relations
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@index([storeId])
  @@map("shipping_integrations")
}
